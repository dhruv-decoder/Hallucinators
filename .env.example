# Copy to .env and fill in. .env is gitignored and never committed.

# --- Model providers (only needed once the proxy/serve layer is wired up) ---
# The gateway is OpenAI-compatible and uses litellm, so any provider works via one base URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: a local open-weights model for the cheap "route-down" target and for
# white-box uncertainty probes (served via Ollama or vLLM).
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=

# ControlPlane P2 proxy
# 'mock' requires no external model. Use 'upstream' for any OpenAI-compatible API.
CONTROLPLANE_BACKEND=mock
CONTROLPLANE_UPSTREAM_BASE_URL=http://localhost:8001/v1
CONTROLPLANE_API_KEY=
CONTROLPLANE_HOST=0.0.0.0
CONTROLPLANE_PORT=8000
CONTROLPLANE_REQUEST_TIMEOUT_S=60

# P2 recorder / policy
CONTROLPLANE_RECORDER_DB_PATH=controlplane.db
CONTROLPLANE_POLICY_PATH=policies/policies.yaml
CONTROLPLANE_USE_CASE=default
CONTROLPLANE_GEOGRAPHY=*
CONTROLPLANE_RISK_APPETITE=balanced
CONTROLPLANE_OVERSIGHT_ENABLED=true

# --- Concurrency / streaming ---
CONTROLPLANE_LATENCY_BUDGET_MS=100
CONTROLPLANE_TIER_TIMEOUT_T0_MS=25
CONTROLPLANE_TIER_TIMEOUT_T1_MS=75
CONTROLPLANE_TIER_TIMEOUT_T2_MS=250
CONTROLPLANE_STREAM_ABORT_ENABLED=true
