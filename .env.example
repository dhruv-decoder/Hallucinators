# Copy to .env and fill in. .env is gitignored and never committed.

# --- Model providers (only needed once the proxy/serve layer is wired up) ---
# The gateway is OpenAI-compatible and uses litellm, so any provider works via one base URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: a local open-weights model for the cheap "route-down" target and for
# white-box uncertainty probes (served via Ollama or vLLM).
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=

# --- Recorder ---
# Where the flight recorder writes its append-only log (reference store; P2 upgrades to SQLite).
CONTROLPLANE_RECORDER_PATH=recorder_log.jsonl

GROQ_API_KEY=            # free Groq key goes in your local .env (gitignored), never in this file

# Runtime protection / observability (optional; defaults are safe for the demo)
CONTROLPLANE_MAX_CONCURRENCY=32
CONTROLPLANE_QUEUE_TIMEOUT_MS=250
CONTROLPLANE_UPSTREAM_TIMEOUT_S=30
CONTROLPLANE_UPSTREAM_RETRIES=1

# Optional model warm-up / readiness. Render enables this so health checks wait for model initialization.
CONTROLPLANE_WARMUP=0

# --- Semantic cache (real embedding near-duplicate cache; needs `pip install sentence-transformers`) ---
# When on, a paraphrase of a recent prompt is served from cache (a genuine upstream-call bypass) if the
# embedding cosine similarity exceeds the threshold. Conservative by default so it never serves a wrong
# cached answer. Safety still runs on every served response.
CONTROLPLANE_SEMANTIC_CACHE=0
CONTROLPLANE_SEMANTIC_CACHE_THRESHOLD=0.90

# --- Live p_fail calibration (on by default; fit offline with `python -m controlplane.cascade.calibrate_live`) ---
CONTROLPLANE_CALIBRATE=1
