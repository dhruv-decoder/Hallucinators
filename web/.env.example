# In dev, leave this unset: /api/* is proxied to the backend via next.config (BACKEND_ORIGIN, default
# http://127.0.0.1:8000). In production (Vercel), set this to the deployed backend origin, e.g.:
# NEXT_PUBLIC_API_BASE=https://controlplane-tower.onrender.com
NEXT_PUBLIC_API_BASE=

# Only used by the dev rewrite proxy (next.config.mjs):
BACKEND_ORIGIN=http://127.0.0.1:8000
